# ── 站点(必配)──────────────────────────────────────────────
# 生产域名,影响 canonical/sitemap/hreflang/OG 的绝对地址
NEXT_PUBLIC_SITE_DOMAIN=https://zoyku.com
SITE_DOMAIN=https://zoyku.com

# ── 站长验证(部署后按需配置,URL 即自动可用)────────────────
# 内容 = 验证文件名本身,如 google1a2b3c4d5e.html
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BAIDU_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── IndexNow(openssl rand -hex 16 生成)──────────────────────
INDEXNOW_KEY=
